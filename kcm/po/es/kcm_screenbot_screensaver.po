msgid "Strong"
msgstr "Intensa"

#: ui/main.qml:509
#, kde-format
msgctxt "@info Burn-in protection"
msgid ""
"Moves the scene and clock, then fades to black between 30 and 60 minutes. "
"Any input closes the screensaver and cancels the fade."
msgstr ""
"Mueve la escena y el reloj, y luego funde la imagen a negro entre los 30 y "
"60 minutos. Cualquier entrada cierra el salvapantallas y cancela el fundido."

#: ui/main.qml:511
#, kde-format
msgctxt "@info Burn-in protection"
msgid ""
"Moves the scene slowly and lets the clock drift within its selected area."
msgstr ""
"Desplaza lentamente la escena y permite que el reloj se mueva dentro del "
"área seleccionada."

#: ui/main.qml:512
#, kde-format
msgctxt "@info Burn-in protection"
msgid "Off preserves the original fixed layout and brightness."
msgstr "Desactivado conserva la disposición fija y el brillo originales."

