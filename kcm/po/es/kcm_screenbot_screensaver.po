#: locationsearch.cpp:183
#, kde-format
msgid "No matches. Check the spelling, or try a nearby larger town."
msgstr ""
"Sin coincidencias. Revise la ortografía o pruebe con una ciudad cercana más "
"grande."

#: screenbotkcm.cpp:557
